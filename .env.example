ANTHROPIC_API_KEY=your-key-here
CLAUDE_MODEL=claude-sonnet-5-5
USE_VECTOR=1
API_URL=http://localhost:8000
DB_BACKEND=sqlite
# For Cloud SQL PostgreSQL, set DB_BACKEND=postgres and configure:
# DB_HOST=/cloudsql/PROJECT:REGION:INSTANCE
# DB_NAME=invoices
# DB_USER=invoice_app
# DB_PASSWORD=load-from-a-secret-manager
# optional, for cost estimates in eval (USD per million tokens, from the pricing page)
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0
